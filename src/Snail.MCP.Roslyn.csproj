<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Snail.MCP.Roslyn</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <PackageType>McpServer</PackageType>
        <PackageId>Snail.MCP.Roslyn</PackageId>
        <PackageTags>AI; MCP; server; roslyn; code-analysis</PackageTags>
        <Description>MCP server that keeps a C# solution compiled and answers an agent faster than it loses the thread.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Roslyn.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
      <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
      <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
      <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    </ItemGroup>

    <!-- MSBuild assemblies must come from the installed SDK at run time, never from NuGet: MSBuildLocator loads them. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.StringTools" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" PrivateAssets="all">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Shipped analyzers, loaded at run time for projects that reference none of their own.
         Excluded from our own build so they lint the analysed code, not this server. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.400"
                          PrivateAssets="all" ExcludeAssets="analyzers;runtime" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="CopyShippedAnalyzers" AfterTargets="Build">
        <ItemGroup>
            <ShippedAnalyzer Include="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)/analyzers/dotnet/cs/*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(ShippedAnalyzer)" DestinationFolder="$(OutDir)analyzers" SkipUnchangedFiles="true" />
    </Target>

</Project>
