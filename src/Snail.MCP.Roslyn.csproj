<Project Sdk="Snail.Sdk.Mcp">

    <!--
        Framework-dependent (SnailMcpNative false): Roslyn and MSBuild load code while the server runs, which a native
        program cannot. Both transports: stdio for the caller that starts it, an address for every worker of a machine,
        which is how the container runs it.
    -->
    <PropertyGroup>
        <SnailMcpNative>false</SnailMcpNative>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <SnailMcpContainer>true</SnailMcpContainer>
    </PropertyGroup>

    <PropertyGroup>
        <PackageTags>AI; MCP; server; roslyn; code-analysis</PackageTags>
        <Description>MCP server that keeps a C# solution compiled and answers an agent faster than it loses the thread.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Roslyn.Tests" />
        <InternalsVisibleTo Include="Snail.MCP.Roslyn.Benchmarks" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
        <PackageReference Include="Microsoft.AspNetCore.Razor.Language" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
    </ItemGroup>

    <!-- MSBuild assemblies must come from the installed SDK at run time, never from NuGet: MSBuildLocator loads them. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Shipped analyzers, loaded at run time for projects that reference none of their own.
         Excluded from our own build so they lint the analysed code, not this server. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers"
                          PrivateAssets="all" ExcludeAssets="analyzers;runtime" GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="CopyShippedAnalyzers" AfterTargets="Build">
        <ItemGroup>
            <ShippedAnalyzer Include="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)/analyzers/dotnet/cs/*.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(ShippedAnalyzer)" DestinationFolder="$(OutDir)analyzers" SkipUnchangedFiles="true" />
    </Target>

</Project>
