<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Snail.MCP.Roslyn.csproj" />
  </ItemGroup>

  <!-- A test that needs the compiler to see a file writes it into src and deletes it in a finally, which a
       killed run never reaches. What survives does not compile, so it breaks the next build before any test
       could clean up after itself. This runs ahead of the referenced project's compilation; the names come
       from Support/Leftovers.cs, which builds them from this same prefix. -->
  <Target Name="SweepLeftovers" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Leftover Include="$(MSBuildThisFileDirectory)../src/SuiteArtifact.*.cs" />
    </ItemGroup>
    <Delete Files="@(Leftover)" />
  </Target>

</Project>